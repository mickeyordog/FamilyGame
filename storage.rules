rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Replace with the same host UID as in firestore.rules.
    function isHost() { return request.auth != null && request.auth.uid in ['REPLACE_WITH_HOST_UID']; }

    match /games/{game}/clips/{file} {
      allow read: if true;
      allow create, update: if isHost()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if isHost();
    }
  }
}
